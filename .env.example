# ================================================================
# SAFFUL-MD — FULL STANDARD ENVIRONMENT TEMPLATE
# Copy this file to .env and replace every 233XXXXXXXXX value.
# Use country-code numbers without +, spaces or leading zeroes.
# Keep .env private. Never upload it or include it in a test ZIP.
# ================================================================

# ----------------------------------------------------------------
# DEVICES AND ACCOUNT IDENTITY
# DEVICE_COUNT accepts 1 or 2. Device 1 uses the unsuffixed values.
# Device 2 inherits shared behaviour and uses the _2 overrides below.
# ----------------------------------------------------------------
DEVICE_COUNT=2

# Device 1
OWNER_NUMBER=233XXXXXXXXX
SUDO=233XXXXXXXXX
OWNER_NAME=Safful
BOT_NAME=Safful-Md
AUTH_METHOD=qr
PAIRING_NUMBER=233XXXXXXXXX
PORT=8001

# Device 2 — ignored when DEVICE_COUNT=1
OWNER_NUMBER_2=233XXXXXXXXX
SUDO_2=233XXXXXXXXX
OWNER_NAME_2=Safful
BOT_NAME_2=Safful-Md-2
AUTH_METHOD_2=qr
PAIRING_NUMBER_2=233XXXXXXXXX
PORT_2=8002

# The bot always prints a standard scannable terminal QR. L keeps its matrix
# as small as possible without replacing QR modules with unreliable glyphs.
QR_ERROR_CORRECTION=L

# Optional per-device databases. Leave blank to inherit Device 1 values.
MONGODB_URI_2=
DATABASE_URL_2=

# ----------------------------------------------------------------
# COMMANDS, MODE AND APPEARANCE
# MODE/WORKTYPE: private, public, group or inbox (private is safest).
# THEME: SAFFUL, GIG, EXPONENT, GOJO, GOKU, LUFFY, MATRIX, etc.
# ----------------------------------------------------------------
PREFIX=.
MODE=private
WORKTYPE=private
THEME=SAFFUL
MENU=
STYLE=1
TZ=Africa/Accra
TIME_ZONE=Africa/Accra
WARN_COUNT=3
DISABLE_PM=false
DISABLE_GROUPS=false
ALLOW_JID=
BLOCK_JID=

# ----------------------------------------------------------------
# LOGIN, SESSION AND HISTORY
# AUTH_METHOD accepts qr or pairing. Pairing uses PAIRING_NUMBER.
# Keep full history disabled on small hosting panels to save memory.
# ----------------------------------------------------------------
SAFFUL_SELF_HOSTED=true
SAFFUL_AUTH_AUTORECOVER=true
SAFFUL_NO_AUTO_RESTORE=false
SAFFUL_FULL_HISTORY=false
SAFFUL_DISABLE_HISTORY_SYNC=true
SAFFUL_ENABLE_SESSION_ID=false
SESSION_ID=
SCAN_URL=

# ----------------------------------------------------------------
# PRESENCE, READ RECEIPTS AND STATUS
# STATUS_VIEW_INTERVAL: 0/off, on/instant, or a delay from 1 to 10 minutes.
# ----------------------------------------------------------------
SAFFUL_PRESERVE_DM_NOTIFICATIONS=true
SAFFUL_PRESENCE_REASSERT_MS=60000
WAPRESENCE=unavailable
READ_MESSAGE=false
READ_COMMAND=false
READ_MESSAGE_FROM=null
AUTO_READ_STATUS=false
READ_STATUS_FROM=null
AUTO_SAVE_STATUS=false
SAVE_STATUS_FROM=null
STATUS_VIEW_INTERVAL=0

# ----------------------------------------------------------------
# GROUP AND STARTUP BEHAVIOUR
# These can also be controlled by bot commands where supported.
# ----------------------------------------------------------------
WELCOME=false
CAN_WELCOME=false
GOODBYE=false
CAN_GOODBYE=false
FLUSH=false
ANTILINK_VALUES=all
ANTI_DELETE=false

# Anti-delete/view-once storage limits
ANTI_DELETE_VIEW_ONCE_MAX_MB=64
ANTI_DELETE_VIEW_ONCE_CACHE_MAX_MB=512
ANTI_DELETE_VIEW_ONCE_TTL_HOURS=72

# ----------------------------------------------------------------
# MEMORY AND LOCAL STORE LIMITS
# Defaults are suitable for ordinary Node.js panels.
# ----------------------------------------------------------------
SAFFUL_CACHE_MESSAGES=120
SAFFUL_CACHE_CHATS=100
SAFFUL_STORE_WRITE_SECONDS=60

# ----------------------------------------------------------------
# BRANDING AND MEDIA
# URL or local file overrides may be left blank to use bundled assets.
# ----------------------------------------------------------------
PACK_NAME=Safful
PACK_AUTHER=Safful
STICKER_PACK=SAFFUL-MD
STICKER_AUTHOR=Safful Tech
CAPTION=Safful-Md
THUMB_IMAGE=
IMAGE=
USER_IMAGES=

# ----------------------------------------------------------------
# DATABASES — OPTIONAL
# DATABASE_URL is PostgreSQL. MONGODB_URI is MongoDB.
# ----------------------------------------------------------------
MONGODB_URI=
DATABASE_URL=

# ----------------------------------------------------------------
# DOWNLOAD SERVICES — OPTIONAL
# Multiple RapidAPI keys are comma-separated with no spaces.
# Without SAFFUL_YT_COOKIES, .song can use the panel-private cookie file:
# /home/container/.safful-secrets/youtube-cookies.txt
# ----------------------------------------------------------------
RAPIDAPI_KEY=
RAPIDAPI_KEYS=
SAFFUL_YT_COOKIES=
SAFFUL_YTDLP_PATH=

# ----------------------------------------------------------------
# OPTIONAL API KEYS
# Leave blank when the related command/service is not used.
# ----------------------------------------------------------------
OPENAI_API_KEY=
ELEVENLAB_API_KEY=
AITTS_ID=37
REMOVE_BG_KEY=
URLSCAN_API_KEY=
KOYEB_API=
HEROKU_API_KEY=
HEROKU_APP_NAME=

# ----------------------------------------------------------------
# HOSTING, HEALTH URL AND GIT UPDATE SETTINGS
# APP_URL is optional; WhatsApp itself only requires outbound connectivity.
# ----------------------------------------------------------------
APP_URL=
GIT_BRANCH=main
BRANCH=main
GIT_REPO_URL=https://github.com/godfada-sa/5AFFUL-BOT.git
GITHUB=

# ----------------------------------------------------------------
# LOGGING AND ADVANCED COMPATIBILITY
# MSGS_IN_LOG may be false, error, info, warn or all.
# ----------------------------------------------------------------
MSGS_IN_LOG=error
NO_COLOR=
ERROR_CHAT=
DEVS=
VERSION=3.6.0
