# Identity and access
OWNER_NUMBER=233XXXXXXXXX
SUDO=233XXXXXXXXX
OWNER_NAME=Safful
BOT_NAME=Safful-Md

# Bot behaviour
PREFIX=.
MODE=private
PORT=8001
TZ=Atlantic/Reykjavik
SAFFUL_SELF_HOSTED=true
# Optional override. Without this, .song reads the ignored private file at
# /home/container/.safful-secrets/youtube-cookies.txt automatically.
SAFFUL_YT_COOKIES=
# Keep WhatsApp mobile notifications for incoming private messages. The guard
# is enabled by default; these values make the intended hosted setup explicit.
SAFFUL_PRESERVE_DM_NOTIFICATIONS=true
READ_MESSAGE=false
READ_COMMAND=false
WAPRESENCE=unavailable

# Theme pack loaded at boot from Themes/<NAME>.json (SAFFUL, GIG, EXPONENT, ...).
# Change it live from WhatsApp with `.theme <name>` — no need to edit this by hand.
THEME=SAFFUL

# Fresh-login method for non-interactive hosts such as systemd.
# Use `pairing` with the WhatsApp number to link, or set AUTH_METHOD=qr.
# A pairing-code timeout requests a fresh code; it never switches to QR.
AUTH_METHOD=qr
PAIRING_NUMBER=233XXXXXXXXX

# Optional external services. Leave blank unless you use them.
MONGODB_URI=
DATABASE_URL=
