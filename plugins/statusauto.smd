'use strict'
// Status auto-view engine (readable port of the obfuscated original).
//
// Modes (persisted to lib/safful-autoview.json):
//   instant  — mark every incoming status seen immediately (default)
//   <1-10>   — mark statuses seen after the given delay in minutes
//   off      — do not mark anything seen
//
// Owner statuses are never auto-viewed (viewing an owner's own status adds
// nothing and just burns receipts). Command chatter is silent by design.

const fs = require('fs')
const path = require('path')
const { smd } = require('../lib/plugins')

const STATE_FILE = process.env.SAFFUL_AUTOVIEW_FILE || path.join(__dirname, '..', 'lib', 'safful-autoview.json')
const RETRY_DELAY_MS = 30 * 1000

const pending = new Map() // status key id -> { key, queuedAt, dueAt, retryAt }
const seenIds = new Set() // already viewed — redeliveries (reconnects) are skipped
let socket = null
let mode = 'instant'
let flushTimer = null
let statusSave = null // resolved lazily — this file loads before ../lib exists
let flushing = false
let connected = false

// ── persistence ────────────────────────────────────────────────────────────
function normalizeMode(value) {
  const text = String(value || '').trim().toLowerCase()
  if (text === 'on') return 'instant'
  if (!text || text === 'instant' || text === 'off') return text || 'instant'
  if (/^(?:[1-9]|10)$/.test(text)) return text
  return null
}

function loadMode() {
  try {
    const saved = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'))
    // Migrate the legacy { minutes: N } shape.
    if (Object.prototype.hasOwnProperty.call(saved, 'minutes')) {
      if (Number(saved.minutes) === 0) return 'off'
      const migrated = normalizeMode(String(saved.minutes))
      if (migrated) return migrated
    }
    const normalized = normalizeMode(saved.mode)
    if (normalized) return normalized
  } catch {}
  if (String(process.env.STATUS_VIEW_INTERVAL).trim() === '0') return 'off'
  const envMode = normalizeMode(process.env.STATUS_VIEW_INTERVAL ?? '')
  return envMode || 'instant'
}

function saveMode(next) {
  fs.mkdirSync(path.dirname(STATE_FILE), { recursive: true })
  const temporary = STATE_FILE + '.tmp'
  fs.writeFileSync(temporary, JSON.stringify({ mode: next }, null, 2) + '\n', 'utf8')
  fs.renameSync(temporary, STATE_FILE)
}

function remember(set, id) {
  set.add(id)
  if (set.size > 1000) set.delete(set.values().next().value)
}

// ── receipts ───────────────────────────────────────────────────────────────
function normalizedAuthor(value) {
  const jid = String(value || '').replace(/:\d+@/, '@')
  return /^\d+@(?:s\.whatsapp\.net|lid)$/.test(jid) ? jid : ''
}

async function markSeen(target, key, progress = {}) {
  if (!key?.id) return
  const sender = normalizedAuthor(key.participant) || normalizedAuthor(key.participantAlt)
  if (!sender) throw new Error('Status ' + key.id + ' has no sender JID; cannot mark seen.')
  if (typeof target?.sendReceipt === 'function') {
    // Status receipts address the broadcast, with the author as participant.
    if (!progress.authorRead) {
      await target.sendReceipt('status@broadcast', sender, [key.id], 'read')
      progress.authorRead = true
    }
  } else if (!progress.authorRead && typeof target?.readMessages === 'function') {
    await target.readMessages([{ ...key, remoteJid: 'status@broadcast', participant: sender }])
    progress.authorRead = true
  }
  if (typeof target?.sendNode !== 'function') throw new Error('Socket has no status-specific receipt transport; owner-side viewing cannot be synchronized')
  // Native status-view receipts are not ordinary message receipts. The class
  // attribute is missing from Baileys sendReceipt/readMessages. Wire reference:
  // Auties00/Cobalt LiveLinkedWhatsAppClient.markStatusViewed, adapting
  // WAWebHandleStatusReceipt.sendStatusMsgRead. Keep the actual author identity.
  await target.sendNode({ tag: 'receipt', attrs: {
    id: key.id, type: 'read', class: 'status', to: 'status@broadcast', participant: sender,
  } })
  updateLocalStatus(target, key)
}

function updateLocalStatus(target, key) {
  // Keep the bot store consistent. This is a local update, not a phone-sync ACK.
  target.ev?.emit?.('messages.update', [{ key: { ...key }, update: { statusAlreadyViewed: true } }])
}

// ── flush scheduling ───────────────────────────────────────────────────────
function reschedule() {
  if (flushTimer) { clearTimeout(flushTimer); flushTimer = null }
  if (mode === 'off' || !pending.size || !connected) return
  const now = Date.now()
  const nextDue = Math.min(...[...pending.values()].map(entry => entry.retryAt && entry.retryAt > now ? entry.retryAt : entry.dueAt))
  flushTimer = setTimeout(() => {
    flush({}).catch(error => console.error('[autoview] flush failed:', error.message || error))
  }, global.saffulChatbotPaused === true ? 1000 : Math.max(0, nextDue - now))
  flushTimer.unref?.()
}

async function flush({ force = false } = {}) {
  if (flushing || mode === 'off' || !pending.size || !socket || !connected) return 0
  if (global.saffulChatbotPaused === true) { reschedule(); return 0 }
  flushing = true
  const target = socket
  const now = Date.now()
  const due = [...pending.values()].filter(entry =>
    force || (entry.dueAt <= now && (!entry.retryAt || entry.retryAt <= now)))
  let seen = 0
  for (const entry of due) {
    if (mode === 'off' || global.saffulChatbotPaused === true || target !== socket || !connected) break
    if (pending.get(entry.key.id) !== entry) continue
    if (!force && entry.dueAt > Date.now()) continue
    try {
      await markSeen(target, entry.key, entry)
      remember(seenIds, entry.key.id)
      pending.delete(entry.key.id)
      seen += 1
    } catch (error) {
      entry.retryAt = Date.now() + RETRY_DELAY_MS
      console.error('[autoview] receipt failed for', entry.key.id + ':', error.message || error)
    }
  }
  flushing = false
  if (seen) console.log('[autoview] sent status receipt(s) for', seen, 'status(es); primary-phone UI sync is not confirmed')
  reschedule()
  return seen
}

// ── mode switching ─────────────────────────────────────────────────────────
function setMode(next) {
  const normalized = normalizeMode(next)
  if (!normalized) throw new Error('Use .autoview on, .autoview off, or .autoview 1-10. Zero is no longer supported.')
  saveMode(normalized)
  mode = normalized
  if (mode === 'off') {
    pending.clear()
  } else {
    const delayMs = mode === 'instant' ? 0 : Number(mode) * 60 * 1000
    for (const entry of pending.values()) {
      entry.dueAt = entry.queuedAt + delayMs
      delete entry.retryAt
    }
  }
  reschedule()
  return mode
}

// ── wiring ─────────────────────────────────────────────────────────────────
function onMessages({ messages } = {}) {
  if (global.saffulChatbotPaused === true || mode === 'off' || !socket) return
  for (const message of messages || []) {
    const key = message?.key
    if (!key?.id || key.remoteJid !== 'status@broadcast' || key.fromMe || message.statusAlreadyViewed) continue
    // Never auto-view the owner's own statuses.
    const ownerNumber = String(process.env.OWNER_NUMBER || global.owner || '').replace(/\D/g, '')
    const authors = [normalizedAuthor(key.participant), normalizedAuthor(key.participantAlt)].filter(Boolean)
    const self = [socket.user?.id, socket.user?.lid].map(normalizedAuthor)
    if (!authors.length || authors.some(jid => self.includes(jid) || jid === ownerNumber + '@s.whatsapp.net')) continue
    if (pending.has(key.id) || seenIds.has(key.id)) continue
    const delayMs = mode === 'instant' ? 0 : Number(mode) * 60 * 1000
    const queuedAt = Date.now()
    pending.set(key.id, {
      key: { ...key, remoteJid: 'status@broadcast', fromMe: false },
      queuedAt,
      dueAt: queuedAt + delayMs,
    })
    if (pending.size > 1000) pending.delete(pending.keys().next().value)
  }
  if (pending.size) {
    if (mode === 'instant') flush({}).catch(() => {})
    else reschedule()
  }
}

function attach(target) {
  if (!target || target.__saffulAutoViewAttached) return target
  target.__saffulAutoViewAttached = true
  socket = target
  connected = target.ws?.isOpen !== false
  if (!statusSave) {
    try { statusSave = require('../lib/safful-status-save') } catch { statusSave = null }
  }
  statusSave?.attach?.(target)
  // New personal statuses can arrive as top-level packets with no upsert.
  // Their envelope supplies the receipt key. Subscribe to the broadcast
  // route only; the generic CB:status listener independently handles ACKs.
  target.ws?.on?.('CB:status,from:status@broadcast', node => {
    const attrs = node?.attrs
    if (target !== socket || node?.tag !== 'status' || attrs?.from !== 'status@broadcast' || !attrs.id) return
    if (attrs.type && !['text', 'media'].includes(attrs.type)) return
    if (attrs.t && Date.now() / 1000 - Number(attrs.t) >= 86400) return
    const participant = normalizedAuthor(attrs.participant)
    if (!participant) return
    const participantAlt = normalizedAuthor(attrs.participant_pn) || normalizedAuthor(attrs.participant_lid)
    onMessages({ messages: [{ key: { id: attrs.id, remoteJid: attrs.from, participant, participantAlt } }] })
  })
  // Ride the raw dispatcher when present (pre-serialization statuses),
  // otherwise fall back to the normal event.
  if (target.__saffulRawDispatcher?.onUpsert) target.__saffulRawDispatcher.onUpsert(onMessages)
  else target.ev?.on?.('messages.upsert', onMessages)
  target.ev?.on?.('connection.update', update => {
    if (socket !== target) return
    if (update.connection === 'close') {
      connected = false
      if (flushTimer) clearTimeout(flushTimer)
      flushTimer = null
    } else if (update.connection === 'open') {
      connected = true
      reschedule()
    }
  })
  reschedule()
  return target
}

smd({
  on: 'text',
  dontAddCommandList: true,
  filename: __filename,
}, async (message, text, extra) => {
  // The command plugin (autoview.js) owns the user interface; this handler
  // exists only so the engine's socket arrives with the legacy dispatch pass.
  void message; void text
  attach(extra?.Void || message?.bot || global.__saffulLatestSocket)
})

module.exports = {
  getMode: () => mode,
  normalizeMode,
  setMode,
  getMinutes: () => (mode === 'off' ? 0 : mode === 'instant' ? 0 : Number(mode)),
  setMinutes: minutes => setMode(Number(minutes) === 0 ? 'off' : String(minutes)),
  flush,
  attach,
  _pending: pending,
}

mode = loadMode()
if (mode === 'off') console.log('[autoview] disabled — statuses will not be marked seen')
else console.log('[autoview] ' + (mode === 'instant' ? 'instant mode — marking statuses seen immediately' : 'viewing statuses every ' + mode + ' minute(s)'))
