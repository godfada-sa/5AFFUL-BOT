DEVICE_COUNT=1  # set device count to 2 if you're pairing 2 devices

# Device 1
OWNER_NUMBER=233xxxxxxxxx
SUDO=233xxxxxxxxx
OWNER_NAME=Device1
BOT_NAME=Device1
AUTH_METHOD=pairing  #use =qr when pairing code fails
PAIRING_NUMBER=233xxxxxxxxx
PORT=8001

# Device 2 — ignored when DEVICE_COUNT=1
OWNER_NUMBER_2=233xxxxxxxxx
SUDO_2=233xxxxxxxxx
OWNER_NAME_2=Device2
BOT_NAME_2=Device2
AUTH_METHOD_2=pairing #use =qr when pairing code fails
PAIRING_NUMBER_2=233xxxxxxxxx
PORT_2=8002

QR_ERROR_CORRECTION=L
PREFIX=.
MODE=private
THEME=SAFFUL
TZ=Africa/Accra
TIME_ZONE=Africa/Accra
SAFFUL_PRESERVE_DM_NOTIFICATIONS=true
